2: early() {
	
	// pre-plan migration of individuals to adjacent subpops

	// post-migration density-dependent selection on each subpop
	for (subpop in sim.subpopulations[0])
	{
		
		inds = subpop.individuals;
		
		// non-overlapping generations; kill off the parental generation
		ages = inds.age;
		inds[ages > 0].fitnessScaling = 0.0;
		inds = inds[ages == 0];
		
		juvenileCount = sum(subpop.individuals.age == 0);
		if(juvenileCount==0) dd=1;
		if(juvenileCount>0) dd= K / juvenileCount; // dd = density dependence
		Tpop = subpop.getValue("tempx");
		nor = (1- ((Tpop- Z)/w)^2)*0.59*exp(0.0633*Tpop); //Norberg equation /// original is 0.0633
		nor2 = nor + R - 0.59; //HARD CODING. The 0.59 comes from when Tpop=Z in last equation
		nor3 = nor2;
		nor3[nor2<0]=0;
		//print(paste(subpop, juvenileCount, dd, nor3));
		//print(paste(subpop, dd, nor3));
		subpop.fitnessScaling = nor3*dd;
	}

	
	if(sim.cycle>burnin){
		
		// Constant Mode begins here
		// Constant Mode begins here
		// Constant Mode begins here
		// Constant Mode begins here
		
		if(mode == "constant"){
			
			for (i in seqLen(N))
				defineGlobal("season", "constant_summer");
			sim.subpopulations[i].setValue("constant_summer", 0.0);
		
		} // Close constant mode
		
		// Constant ENDS begins here
		// Constant ENDS begins here
		// Constant ENDS begins here
		// Constant ENDS begins here
		
		// <#### ------------------------- #####>
		
		// Seasonal Mode begins here
		// Seasonal Mode begins here
		// Seasonal Mode begins here
		// Seasonal Mode begins here
		
		if(mode == "seasonal"){
			
			catn("Cycle= "+ sim.cycle);
			
			catn("X= "+ x);
			catn("Y= "+ y);
			
			///what happens in sims
			for (i in seqLen(N)){
				//	print(paste(sim.cycle, season, "x=", x, "y=", y, sim.subpopulations.getValue("tempx"), sim.subpopulations.individualCount));
				if (x >= 11){
					/// summer is optimum temperature - lasts 11 generations
					defineGlobal("season", "winter");
					defineGlobal("x", 0.0);
					defineGlobal("y", 0.0);

				}
				if (y >= 4){
					/// winter is tempx = wt, lasts 4 generations
					defineGlobal("season", "summer");
					defineGlobal("x", 0.0);
					defineGlobal("y", 0.0);
					defineGlobal("years", years+1);

				}
				if (season == "summer"){
					defineGlobal("x", x+1);;
					//sim.setValue("x", sim.getValue(x) + 1);			
					sim.subpopulations[i].setValue("tempx", 0.0);
					/// summer is optimum temperature - lasts 11 generations
					/// winter is tempx = -0.6, lasts 4 generations
				}
				if (season == "winter"){
					defineGlobal("y", y+1);
					//sim.setValue("y", y + 1);	
					sim.subpopulations[i].setValue("tempx", wintertemp);
				}
			}
		} //// close seasonal loop
		
		// Seasonal Mode ends here
		// Seasonal Mode ends here
		// Seasonal Mode ends here
		// Seasonal Mode ends here
		
		
		//print(paste(sim.cycle, season, sim.subpopulations.individualCount, "x=", x, "y=", y, sim.subpopulations.getValue("tempx")));
		//print(paste(sim.cycle, season, sim.subpopulations.individualCount));
		
		//write pop size file	
		
		//writeFile(filePath = paste(path_pop, paste("PopSizes" , sim.cycle, mode, wintertemp, model, "txt", sep = ".") , sep = ""), contents = paste(sim.cycle, season, sim.subpopulations.individualCount, x, y, sim.subpopulations.getValue("tempx"),  sep = "\t"), append = T );
	
	}
}


