	// create an initial population of 100 individuals, the rest empty
	for (i in seqLen(N))
		sim.addSubpop(i, (i == (N-1)/2) ? PopSize else 0) //initial popualation starts in the middle subpop
		//load data from a vcf		
		// <----- uncomment for neutral VCF
		[i].genomes.readFromVCF("/users/a/r/armccrac/suzukii/Neutral_L100K_N500K.vcf", m1);
	
	//sim.subpopulations[i].readFromVCF("/Users/jcbnunez/Downloads/Neutral_100k.vcf", m1);
	
	for (i in seqLen(N))
		sim.subpopulations[i].setValue("tempx",temp[i]);
	
}

