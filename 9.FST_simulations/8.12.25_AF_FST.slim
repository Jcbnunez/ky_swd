initialize() {
	
	// Added by Andrew //
	defineConstant("basename",BaseName);
	//defineConstant("replicatei", 1); // replicate run
	//==================//		
	
	defineConstant("K", 2100);   // carrying capacity per subpop; the original number was 2100!
	defineConstant("N", 1);    // number of subpopulations (should be odd to have a true center population)
	defineConstant("PopSize", 5500);    // This number is used for the MSPRIME VCF importation step. may change if treeseq recording is used.
	defineConstant("LCh", 100000);    // This number is "L", derived from genomesize in msprime
	//defineConstant("M", 0.01);   // migration probability
	defineConstant("R", 2.3);   // mean reproduction (as first parent)in the optimal environmment 
	defineConstant("Z", 0.0);	  // Optimal growth temperature
	defineConstant("w", 0.4);    // width of the finess equation
	defineConstant("wintertemp",wt); // lower is a bigger crash in winter
