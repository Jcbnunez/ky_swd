// create output file headers

1:150 late() {
	
	// added by Andrew // 
		
		//catn("n0= " + size(p0.individuals));
		Np0 = sim.subpopulations[0].individualCount; 	
		
		catn(sim.cycle + " | "
		+ "season= " + season + " | "
		+ "y= "+ y + " | "
		+ "x= "+ x + " | "
		+ "Np0# "
		+ Np0 + " | "
		+ " | years= " + years);	
		
		
		muts = unique(sim.mutations);
		fileID = paste0(basename,".txt"); 	
	
	 for(m in muts){
        pos  = m.position;
        id   = m.id;
        freq = sim.mutationFrequencies(p0, m);

        row_str = paste(c(
            replicatei,
            sim.cycle,
            pos,
            id,
            freq,
            wintertemp,
            season,
            years,
            x,
            y,
            Np0
        ), sep = ",");
        
        freq_data = c(freq_data, row_str); // store in memory
    }	
    
    writeFile(fileID, paste(freq_data, sep = "\n"), append=T);
	
		
	//=============//

}